[Unit]
Description=CoolPilot - re-apply the saved boot profile
# power-profile daemons restore their own profile when they start; apply ours after
# them (power-profiles-daemon on most distros, tuned/tuned-ppd on Fedora 41+)
After=power-profiles-daemon.service tuned.service tuned-ppd.service

[Service]
Type=oneshot
Environment=COOLPILOT_USER=@USER@
WorkingDirectory=/opt/coolpilot/backend
ExecStartPre=/bin/sleep 3
ExecStart=/opt/coolpilot/venv/bin/python -m coolpilot.apply_boot
SuccessExitStatus=1

[Install]
WantedBy=graphical.target
