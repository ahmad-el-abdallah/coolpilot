[Unit]
Description=CoolPilot - re-apply the last profile after sleep or charger plug/unplug
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
Environment=COOLPILOT_USER=@USER@
WorkingDirectory=/opt/coolpilot/backend
ExecStartPre=/bin/sleep 2
ExecStart=/opt/coolpilot/venv/bin/python -m coolpilot.apply_boot --reapply
SuccessExitStatus=1

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
