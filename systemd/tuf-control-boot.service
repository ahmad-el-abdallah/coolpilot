[Unit]
Description=TUF Control - re-apply the saved boot profile
# power-profile daemons restore their own profile when they start; apply ours after
# them (power-profiles-daemon on most distros, tuned/tuned-ppd on Fedora 41+)
After=power-profiles-daemon.service tuned.service tuned-ppd.service

[Service]
Type=oneshot
Environment=TUF_USER=@USER@
WorkingDirectory=/opt/tuf-control/backend
ExecStartPre=/bin/sleep 3
ExecStart=/opt/tuf-control/venv/bin/python -m tuf.apply_boot
SuccessExitStatus=1

[Install]
WantedBy=graphical.target
