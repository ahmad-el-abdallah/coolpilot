[Unit]
Description=TUF Control web panel (http://127.0.0.1:8787)
After=network.target

[Service]
Type=simple
Environment=TUF_USER=@USER@
Environment=TUF_DIST=/opt/tuf-control/frontend/dist
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/tuf-control/backend
ExecStart=/opt/tuf-control/venv/bin/python -m tuf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
